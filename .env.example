# ========================================
# GROQ API Key
# ========================================
# Replace with your actual Groq API key.
# You can get one from: https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# ========================================
# Neo4j Database Connection
# ========================================
# Replace these with your Neo4j database credentials.
# Example URI format: neo4j://<your-instance-id>.databases.neo4j.io
NEO4J_URI="neo4j://your_database_uri_here"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"

# ========================================
# Django / Deployment Settings
# ========================================
# Generate a new secret key using:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="your_django_secret_key_here"

# Use 'production' on a VM/server deployment.
DJANGO_ENV="production"

# Comma-separated hostnames/IPs Django should accept.
# Include your VM external IP and/or domain name.
ALLOWED_HOSTS="localhost,127.0.0.1"

# Required for POST forms when using a public host over HTTP/HTTPS.
# Include scheme (http:// or https://).
CSRF_TRUSTED_ORIGINS="http://34.123.45.67"

# Set true only when requests arrive over HTTPS at Django.
# If TLS terminates at a load balancer/reverse proxy, keep this false unless proxy headers are configured.
USE_HTTPS="false"
